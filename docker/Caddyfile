{
	default_sni {$SERVER_ADDRESS:localhost}
	on_demand_tls {
		interval 1m
		burst 10
	}
}

{$SERVER_ADDRESS:localhost}, {$SERVER_DOMAIN:pauk.local}, localhost, 127.0.0.1, :443 {
	tls internal {
		on_demand
	}

	# Корневой сертификат этого Caddy — публичная часть (root.crt).
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=caddy-root.crt"
		file_server
	}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=15552000"
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	@pointfiles path /api/point-files/*
	header @pointfiles {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
	}

	handle /static/games/* {
		header {
			X-Frame-Options "SAMEORIGIN"
			Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
			Cache-Control "no-store"
		}
		reverse_proxy 127.0.0.1:3000 {
			header_down -Server
		}
	}

	handle {
		reverse_proxy 127.0.0.1:3000 {
			header_down -Server
		}
	}
}

:80 {
	redir https://{host}{uri} permanent
}
