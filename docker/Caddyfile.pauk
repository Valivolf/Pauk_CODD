{
	admin off
	auto_https disable_redirects
	https_port {$PAUK_HTTPS_PORT:8443}
	default_sni {$SERVER_ADDRESS:localhost}
}

https://{$SERVER_ADDRESS:localhost}:{$PAUK_HTTPS_PORT:8443}, https://localhost:{$PAUK_HTTPS_PORT:8443}, https://127.0.0.1:{$PAUK_HTTPS_PORT:8443} {
	tls internal

	# Корневой сертификат Caddy для «Паук» (публичная часть root.crt).
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-x509-ca-cert
		header Content-Disposition "attachment; filename=pauk-root.crt"
		file_server
	}

	encode zstd gzip

	header {
		X-Content-Type-Options "nosniff"
		?X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Strict-Transport-Security "max-age=15552000"
		?Content-Security-Policy "frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'"
		-Server
	}

	@pointfiles path /api/point-files/*
	header @pointfiles {
		X-Frame-Options "SAMEORIGIN"
		Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'"
	}

	handle /static/games/* {
		header {
			X-Frame-Options "SAMEORIGIN"
			Content-Security-Policy "frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"
			Cache-Control "no-store"
		}
		reverse_proxy 127.0.0.1:{$PAUK_APP_PORT:3010} {
			header_down -Server
		}
	}

	handle {
		reverse_proxy 127.0.0.1:{$PAUK_APP_PORT:3010} {
			header_down -Server
		}
	}
}
